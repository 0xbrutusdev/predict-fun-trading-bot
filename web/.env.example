# Server-only. Never prefix these with NEXT_PUBLIC_.
BOT_API_URL=http://127.0.0.1:3000
BOT_API_TOKEN=
# Independent random secret, >=32 characters; enter this key on the login page.
DASHBOARD_ACCESS_KEY=
# Auth.js tenant login. When configured, the dashboard uses GitHub OAuth.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Server-only identity-to-Worker registry for SQLite-per-tenant deployments.
# Keys are lowercase GitHub account emails (or Auth.js user IDs).
# BOT_TENANTS_JSON={"trader@example.com":{"tenantId":"trader","role":"trader","url":"https://worker.example.com","token":"replace-with-worker-token-at-least-32-characters"}}
BOT_TENANTS_JSON=
